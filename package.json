{
  "name": "@torridfish/md2s",
  "version": "0.2.2",
  "description": "Stop making slides, do research: plain Markdown to consistent, readable academic slides (PDF, PPTX, HTML) on Marp.",
  "license": "MIT",
  "author": "Torrid Fish <justinwu6900942@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/torridfish/md2s.git"
  },
  "homepage": "https://github.com/torridfish/md2s#readme",
  "bugs": {
    "url": "https://github.com/torridfish/md2s/issues"
  },
  "keywords": [
    "markdown",
    "slides",
    "marp",
    "academic",
    "pdf",
    "pptx"
  ],
  "bin": {
    "md2s": "bin/md2s.js"
  },
  "files": [
    "bin",
    "csl",
    "src",
    "themes",
    "tex",
    "scripts",
    "docs",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "gallery": "node bin/md2s.js examples/gallery.md --pdf -o out/",
    "test": "node test/smoke.js"
  },
  "dependencies": {
    "@citation-js/core": "0.9.0",
    "@citation-js/plugin-bibtex": "0.9.0",
    "@citation-js/plugin-csl": "0.9.0",
    "@hpcc-js/wasm-graphviz": "1.30.0",
    "@marp-team/marp-cli": "4.5.1",
    "markdown-it-attrs": "4.5.0",
    "markdown-it-bracketed-spans": "1.0.3",
    "markdown-it-container": "4.0.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-mark": "4.0.0",
    "markdown-it-multimd-table": "4.2.3",
    "yaml": "2.9.1"
  }
}
